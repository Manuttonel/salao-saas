# Copie este arquivo para ".env" (mesma pasta) e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado no Git (já está no .gitignore).

# --- Flask ---
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-por-uma-string-aleatoria-longa
JWT_SECRET_KEY=troque-por-outra-string-aleatoria-longa
JWT_ACCESS_TOKEN_EXPIRES_HOURS=12
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# --- Banco de dados PostgreSQL ---
# Formato: postgresql+psycopg://usuario:senha@host:porta/nome_do_banco
# (usamos o driver psycopg v3, necessário para Python 3.13+/3.14 no Windows)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/salao_saas
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/salao_saas_test

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Mercado Pago ---
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# (crie uma aplicação e use as credenciais de TESTE enquanto desenvolve)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Painel do Mercado Pago -> Webhooks -> "Assinatura secreta"
MERCADOPAGO_WEBHOOK_SECRET=
# Valor mensal cobrado do salão pela plataforma
PLATFORM_SUBSCRIPTION_PRICE=99.90
# URL pública que o Mercado Pago vai chamar (em dev, use ngrok ou similar
# para expor http://localhost:5000 publicamente, ex.: https://xxxx.ngrok.io/api/webhooks/mercadopago)
MERCADOPAGO_WEBHOOK_URL=http://localhost:5000/api/webhooks/mercadopago

# --- WhatsApp ---
# "meta_cloud_api" (WhatsApp Business Cloud API oficial) ou "evolution_api"
WHATSAPP_PROVIDER=evolution_api
# Enquanto true, mensagens só são logadas no console (não enviadas de verdade)
WHATSAPP_MODO_SIMULACAO=true

# Credenciais Meta Cloud API (https://developers.facebook.com/docs/whatsapp)
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=

# Credenciais Evolution API (https://doc.evolution-api.com)
WHATSAPP_EVOLUTION_BASE_URL=http://localhost:8080
WHATSAPP_EVOLUTION_INSTANCE=salao-saas
WHATSAPP_EVOLUTION_API_KEY=

# --- Regras de agendamento ---
AGENDAMENTO_ANTECEDENCIA_MAXIMA_DIAS=60
